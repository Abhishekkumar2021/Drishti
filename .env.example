# ──────────────────────────────────────────────
# Drishti — दृष्टि
# Environment Configuration Template
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ──────────────────────────────────────────────

# ═══ Required: Database Passwords ═════════════
POSTGRES_PASSWORD=change-this-to-a-secure-password
MINIO_ROOT_USER=drishti
MINIO_ROOT_PASSWORD=change-this-to-a-secure-password
NEO4J_PASSWORD=change-this-to-a-secure-password

# ═══ Required: Authentication ═════════════════
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=

# Optional: API token for bearer auth
API_TOKEN=

# ═══ Required: LLM Provider (choose one) ══════
# Anthropic (recommended)
ANTHROPIC_API_KEY=sk-ant-...

# OR OpenAI
# OPENAI_API_KEY=sk-...

# ═══ Provider Configuration ═══════════════════
# LLM Provider: anthropic, openai, ollama
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-20250514

# Embedding Provider: openai, cohere, ollama
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Reranking Provider: cohere, auto, none
RERANK_PROVIDER=auto

# ═══ Optional: Cohere (for reranking) ═════════
COHERE_API_KEY=

# ═══ Optional: OIDC Authentication ════════════
# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ═══ Optional: Observability ══════════════════
OTEL_ENABLED=false
STRUCTURED_LOGGING=true
LOG_LEVEL=INFO

# ═══ Optional: Feature Flags ══════════════════
NEO4J_ENABLED=false
ENABLE_MINIO=false
WORKER_ENABLED=false
CACHE_ENABLED=true
RATE_LIMIT_ENABLED=true

# ═══ Development Settings ═════════════════════
DEBUG=false
EXPOSE_OPENAPI_DOCS=true

# ═══ Search Defaults ══════════════════════════
SEARCH_TOP_K=10
MAX_CONTEXT_CHUNKS=15
RRF_K=60
