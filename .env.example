# ──────────────────────────────────────────────
# Drishti — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ──────────────────────────────────────────────

# ─── Qdrant Vector Database ──────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=drishti_chunks

# ─── OpenAI (Embeddings) ─────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ─── Anthropic (LLM Generation) ──────────────
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ─── Cohere (Re-ranking) ─────────────────────
COHERE_API_KEY=your-cohere-api-key-here
COHERE_RERANK_MODEL=rerank-v3.5

# ─── Redis (Cache & Rate Limiting) ─────────────
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# ─── Neo4j (Dependency Graph — Phase 4) ──────
NEO4J_ENABLED=false
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=change-me-in-production

# ─── Application ─────────────────────────────
DEBUG=false
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
# Set in production to require Bearer auth on /api/v1/*
API_TOKEN=
EXPOSE_OPENAPI_DOCS=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
HEALTH_CHECK_TIMEOUT_SECONDS=5
# Optional comma-separated allowlist for ingestion paths
# INGESTION_ALLOWED_ROOTS=/data/repos,/Users/you/projects
